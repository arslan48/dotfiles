configuration {
    modes: [ drun, run, window ];
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
    icon-theme: "Papirus";
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Window";
    drun-display-format: "{icon} {name}";
}

@theme "/dev/null"

/* Catppuccin Mocha Color Palette */
* {
    bg-col:      #1e1e2e;
    bg-col-light:#313244;
    border-col:  #89b4fa;
    selected-col:#313244;
    blue:        #89b4fa;
    fg-col:      #cdd6f4;
    fg-col2:     #f38ba8;
    grey:        #6c7086;

    background-color: @bg-col;
    text-color:       @fg-col;
}

window {
    height:           380px;
    border:           2px;
    border-color:     @border-col;
    background-color: @bg-col;
    border-radius:    10px;
    width:            600px;
}

mainbox {
    background-color: @bg-col;
    children: [ inputbar, listview, mode-switcher ];
}

inputbar {
    children:         [prompt, entry];
    background-color: @bg-col;
    border-radius:    5px;
    padding:          2px;
}

prompt {
    background-color: @blue;
    padding:          6px 12px;
    text-color:       #1e1e2e; 
    border-radius:    5px;
    margin:           10px 0px 0px 20px;
}

entry {
    padding:          6px;
    margin:           10px 20px 0px 10px;
    text-color:       @fg-col;
    background-color: @bg-col;
}

listview {
    border:           0px 0px 0px;
    padding:          6px 0px 0px;
    margin:           10px 20px 0px 20px;
    columns:          1;
    lines:            5;
    background-color: @bg-col;
}

element {
    padding:          6px;
    background-color: transparent;
    text-color:       @fg-col;
}

element-icon {
    size:             22px;
    background-color: transparent;
    text-color:       inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    margin:           0px 0px 0px 10px; /* Moves text perfectly away from icon */
}

element selected {
    background-color: @selected-col;
    text-color:       @blue;
    border-radius:    5px;
}

element selected element-text {
    text-color:       @blue;
}

/* --- Fixed Category Ribbon --- */
mode-switcher {
    spacing:          10px;
    margin:           10px 100px 15px 100px; /* Reduced to 100px so "Window" fits perfectly without cutting off */
}

button {
    padding:          4px 12px; /* Increased side padding for a cleaner look */
    background-color: @bg-col-light;
    text-color:       @grey;
    vertical-align:   0.5; 
    horizontal-align: 0.5;
    border-radius:    5px;
}

button selected {
    background-color: @blue;
    text-color:       #1e1e2e;
}
